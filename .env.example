# ============================================
# SPX 0DTE Trading Bot Configuration
# Copy this file to .env and fill in your values
# ============================================

# --- Account Settings ---
STARTING_CAPITAL=1000
DAILY_RETURN_TARGET_PCT=20
MAX_DAILY_DRAWDOWN_PCT=20
MAX_TRADES_PER_DAY=3
MAX_PER_TRADE=200

# --- Broker ---
# Options: paper, ibkr, schwab, tastytrade
BROKER=paper

# --- IBKR (Interactive Brokers) ---
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# --- Schwab ---
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=
SCHWAB_TOKEN_PATH=

# --- Tastytrade ---
TASTYTRADE_USERNAME=
TASTYTRADE_PASSWORD=

# --- Strategy Parameters ---
SPREAD_WIDTH=5
SHORT_PUT_DELTA=-0.16
SHORT_CALL_DELTA=0.16
MIN_CREDIT_PCT=0.10
PROFIT_TARGET_PCT=50
STOP_LOSS_MULTIPLE=2.0
EARLIEST_ENTRY_TIME=09:45
LATEST_ENTRY_TIME=14:30
FORCE_CLOSE_TIME=15:45
MIN_VIX=12
MAX_VIX=35

# --- Logging ---
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Alerts (Discord) ---
ENABLE_DISCORD_ALERTS=false
DISCORD_WEBHOOK_URL=
